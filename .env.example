# ==============================================================================
# AutoPatch Environment Configuration (.env.example)
# ==============================================================================
# Copy to .env for local development. NEVER commit real secrets or .env files.
# All non-secret variables below have safe automatic defaults — the server boots
# cleanly even when optional integrations (Gemini / Neo4j) are not configured.

# ------------------------------------------------------------------------------
# A. SECRETS & CREDENTIALS (Manual input required for AI / GraphRAG features)
# ------------------------------------------------------------------------------
# Server-side Gemini API key (NEVER exposed to browser or execution sandbox)
GEMINI_API_KEY=

# Optional Neo4j AuraDB credentials (required only when GRAPHRAG_ENABLED=true)
# Instance: AutoPatch-GraphDB (example AuraDB format: neo4j+s://<instance-id>.databases.neo4j.io)
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
AURA_INSTANCEID=
AURA_INSTANCENAME=AutoPatch-GraphDB

# Optional API protection token (if set, clients must send Authorization: Bearer <token> or X-API-Key)
AUTOPATCH_API_KEY=

# ------------------------------------------------------------------------------
# B. FEATURE FLAGS & AI MODEL CONFIGURATION (Automatic defaults provided)
# ------------------------------------------------------------------------------
# Enable or disable Neo4j GraphRAG integration (auto-disables gracefully if credentials absent)
GRAPHRAG_ENABLED=true
GRAPHRAG_MAX_TRAVERSAL_DEPTH=2
GRAPHRAG_MAX_NODES=50
GRAPHRAG_EMBEDDING_BATCH_SIZE=16

# Configurable Gemini model identifiers & quotas
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_TIMEOUT_MS=8000
GEMINI_TRANSCRIBE_TIMEOUT_MS=10000
GEMINI_DAILY_QUOTA=500

# ------------------------------------------------------------------------------
# C. SERVER & PERSISTENCE CONFIGURATION (Automatic defaults provided)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
DISABLE_HMR=true
ENABLE_LOCAL_HMR=false
AUDIT_LOG_PATH=.autopatch-data/audit-ledger.ndjson

# ------------------------------------------------------------------------------
# D. ISOLATED EXECUTION SANDBOX LIMITS (Automatic defaults provided)
# ------------------------------------------------------------------------------
# Keep enabled only with Linux namespace + UID nobody isolation; set false for fail-closed static-only mode
SANDBOX_ALLOW_UNTRUSTED_EXEC=true
SANDBOX_TIMEOUT_SECONDS=2.0
SANDBOX_MAX_TIMEOUT_SECONDS=5.0
SANDBOX_MEMORY_MB=256
SANDBOX_NODE_HEAP_MB=192
SANDBOX_CPU_SECONDS=2
SANDBOX_COMPILE_CPU_SECONDS=5
SANDBOX_MAX_OUTPUT_BYTES=65536
SANDBOX_MAX_FILE_BYTES=10485760
SANDBOX_MAX_OPEN_FILES=64
SANDBOX_MAX_PROCESSES=32
MAX_CONCURRENT_EXECUTIONS=4

# ------------------------------------------------------------------------------
# E. API ABUSE & PAYLOAD PROTECTION LIMITS (Automatic defaults provided)
# ------------------------------------------------------------------------------
MAX_SOURCE_SIZE_BYTES=100000
MAX_TEST_SIZE_BYTES=100000
MAX_CONTEXT_SIZE_BYTES=10000
MAX_AUDIO_SIZE_BYTES=2000000
MAX_REQUESTS_PER_MINUTE=60
MAX_AI_REQUESTS_PER_MINUTE=20
MAX_CONCURRENT_ANALYSES=8
